<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/firstFragment">

    <fragment
        android:id="@+id/firstFragment"
        android:name="cl.bootcamp.ind_12.FirstFragment"
        android:label="fragment_first"
        tools:layout="@layout/fragment_first" >
        <action
            android:id="@+id/action_firstFragment_to_secondFragment"
            app:destination="@id/secondFragment" />
    </fragment>
    <fragment
        android:id="@+id/secondFragment"
        android:name="cl.bootcamp.ind_12.SecondFragment"
        android:label="fragment_second"
        tools:layout="@layout/fragment_second" >
        <action
            android:id="@+id/action_secondFragment_to_sakuragiFragment"
            app:destination="@id/sakuragiFragment" />
        <action
            android:id="@+id/action_secondFragment_to_ryotaFragment"
            app:destination="@id/ryotaFragment" />
        <action
            android:id="@+id/action_secondFragment_to_akagiFragment2"
            app:destination="@id/akagiFragment2" />
        <action
            android:id="@+id/action_secondFragment_to_mitsuiFragment"
            app:destination="@id/mitsuiFragment" />
        <action
            android:id="@+id/action_secondFragment_to_rukawaFragment"
            app:destination="@id/rukawaFragment"

            />
    </fragment>
    <fragment
        android:id="@+id/akagiFragment2"
        android:name="cl.bootcamp.ind_12.AkagiFragment"
        android:label="fragment_akagi"
        tools:layout="@layout/fragment_akagi" />
    <fragment
        android:id="@+id/mitsuiFragment"
        android:name="cl.bootcamp.ind_12.MitsuiFragment"
        android:label="fragment_mitsui"
        tools:layout="@layout/fragment_mitsui" />
    <fragment
        android:id="@+id/rukawaFragment"
        android:name="cl.bootcamp.ind_12.RukawaFragment"
        android:label="fragment_rukawa"
        tools:layout="@layout/fragment_rukawa" />
    <fragment
        android:id="@+id/ryotaFragment"
        android:name="cl.bootcamp.ind_12.RyotaFragment"
        android:label="fragment_ryota"
        tools:layout="@layout/fragment_ryota" />
    <fragment
        android:id="@+id/sakuragiFragment"
        android:name="cl.bootcamp.ind_12.SakuragiFragment"
        android:label="fragment_sakuragi"
        tools:layout="@layout/fragment_sakuragi" />
</navigation>